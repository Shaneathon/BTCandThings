[Unit]
Description=TBot authenticated read-only paper status
After=tbot-paper.service
[Service]
User=tbot
Group=tbot
WorkingDirectory=/opt/tbot
EnvironmentFile=/etc/tbot.env
ExecStart=/opt/tbot/venv/bin/python -m trading_bot.server --ledger /var/lib/tbot/paper.sqlite --port 8765
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
[Install]
WantedBy=multi-user.target
