[Unit]
Description=PBot independent paper dashboard
After=pbot-status.service
[Service]
User=pbot
Group=pbot
WorkingDirectory=/opt/pbot
EnvironmentFile=/etc/pbot.env
ExecStart=/opt/pbot/venv/bin/streamlit run trading_bot/app.py --server.address=127.0.0.1 --server.port=8502 --server.headless=true
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
[Install]
WantedBy=multi-user.target
