[Unit]
Description=Coin authenticated read-only research API
After=coin-collector.service
[Service]
User=coin
Group=coin
WorkingDirectory=/opt/coin
EnvironmentFile=/etc/coin.env
ExecStart=/opt/coin/venv/bin/python -m coinbase_tracker.server --db /var/lib/coin/research.sqlite --port 8767
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/coin
UMask=0077
[Install]
WantedBy=multi-user.target
