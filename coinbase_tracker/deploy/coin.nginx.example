# Separate virtual-host TEMPLATE. Add actual TLS after DNS/ownership validation.
# Do not replace BTCandThings, PBot or CBot host blocks.
server {
    listen 80;
    server_name coin.shaneathon.com;
    location / {
        proxy_pass http://127.0.0.1:8504;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600;
    }
}
